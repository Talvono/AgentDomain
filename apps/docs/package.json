{
  "name": "@agentdomain/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Public product, API, and integration documentation for AgentDomain.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Talvono/AgentDomain.git",
    "directory": "apps/docs"
  },
  "homepage": "https://docs.agentdomain.app",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build:ci": "astro build && node ../../scripts/seo/indexnow.mjs prepare-key --site=docs",
    "lint:ci": "node scripts/validate-content.mjs",
    "typecheck:ci": "astro check",
    "test:ci": "node --test test/*.test.mjs",
    "validate:output:ci": "node scripts/validate-output.mjs",
    "build:dependencies": "pnpm --filter @agentdomain/shared build",
    "dev": "pnpm run build:dependencies && astro dev",
    "build": "pnpm run build:dependencies && astro build && node ../../scripts/seo/indexnow.mjs prepare-key --site=docs",
    "build:cloudflare:production": "node ../../scripts/seo/indexnow.mjs verify --site=docs --production && pnpm run check",
    "preview": "pnpm run build && wrangler dev --env preview",
    "deploy": "pnpm run check && node ../../scripts/seo/indexnow.mjs verify --site=docs --production && wrangler deploy && node ../../scripts/seo/indexnow.mjs submit --site=docs --production",
    "lint": "node scripts/validate-content.mjs",
    "typecheck": "pnpm run build:dependencies && astro check",
    "test": "pnpm run build:dependencies && node --test test/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:output": "pnpm run build:dependencies && node scripts/validate-output.mjs",
    "check": "pnpm run validate:content && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run validate:output"
  },
  "dependencies": {
    "@agentdomain/shared": "workspace:*",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.0",
    "astro": "7.3.1",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "zod-to-json-schema": "3.25.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "openapi-types": "12.1.3",
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  }
}
