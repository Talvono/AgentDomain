{
  "name": "agentdomain-public",
  "version": "0.3.0",
  "private": true,
  "description": "Public AgentDomain SDKs, integrations, documentation, and published Base contract artifacts.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "audit:production:high": "pnpm test:dependency-security && pnpm audit --prod --audit-level high",
    "build": "turbo run build",
    "build:public": "turbo run build --filter=!@agentdomain/contracts",
    "check:production-licenses": "node scripts/check-production-licenses.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "ci:cloudflare": "node scripts/public-ci.mjs --cloudflare-only",
    "ci:public": "node scripts/public-ci.mjs",
    "lint": "turbo run lint",
    "lint:public": "turbo run lint --filter=!@agentdomain/contracts",
    "test": "turbo run test",
    "test:dependency-security": "node --test scripts/http-cache-semantics.test.mjs scripts/braces.test.mjs scripts/production-dependencies.test.mjs scripts/reown-zod-override.test.mjs",
    "test:license-gate": "node --test scripts/check-production-licenses.test.mjs",
    "test:public": "pnpm test:dependency-security && node --test scripts/check-public-boundary.test.mjs scripts/verify-release-ci.test.mjs scripts/public-ci.test.mjs scripts/public-pr-scope.test.mjs && pnpm test:license-gate && pnpm --filter @agentdomain/contracts test && turbo run test --filter=!@agentdomain/contracts",
    "typecheck": "turbo run typecheck",
    "typecheck:public": "turbo run typecheck --filter=!@agentdomain/contracts",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,md,mdx,json,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.12",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "browserslist@<4.28.7": "4.28.7",
      "@hono/node-server@<1.19.15": "1.19.15",
      "axios@>=1.15.2 <1.18.0": "1.18.0",
      "@reown/appkit-wallet>zod": "4.6.7",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "decode-uri-component@<0.5.0": "0.5.0",
      "devalue@>=5.0.0 <5.9.3": "5.9.3",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "hono@<4.13.13": "4.13.13",
      "http-cache-semantics": "4.3.0",
      "ip-address@<=10.7.3": "10.7.4",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "qs@<6.16.0": "6.16.0",
      "sharp@<0.35.5": "0.35.5",
      "smol-toml@<1.9.0": "1.9.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "undici@>=8.0.0 <8.12.2": "8.12.2",
      "use-sync-external-store@<1.4.0": "1.4.0",
      "uuid@<11.1.1": "11.1.1",
      "vite@>=8.2.0 <8.2.4": "8.2.4",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "http-cache-semantics@4.3.0": "patches/http-cache-semantics@4.3.0.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
