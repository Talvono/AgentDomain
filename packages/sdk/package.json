{
  "name": "@agentdomain/sdk",
  "version": "0.11.1",
  "description": "TypeScript SDK for AgentDomain agent-native identity and communications APIs, renewals, and x402 workflows",
  "keywords": [
    "agentdomain",
    "ai-agents",
    "typescript",
    "sdk",
    "identity",
    "x402",
    "base",
    "dns"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talvono/AgentDomain.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.agentdomain.app/sdk/typescript",
  "bugs": {
    "url": "https://github.com/Talvono/AgentDomain/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:ci": "tsc",
    "lint:ci": "echo ok",
    "typecheck:ci": "tsc --noEmit",
    "test:ci": "node --test test/*.test.mjs",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo ok"
  },
  "dependencies": {
    "@agentdomain/shared": "workspace:^",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/extensions": "2.25.0",
    "viem": "^2.56.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
