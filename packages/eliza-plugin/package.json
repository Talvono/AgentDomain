{
  "name": "@agentdomain/eliza-plugin",
  "version": "0.11.2",
  "description": "ElizaOS plugin for AgentDomain agent-native identity and communications APIs and renewal workflows",
  "keywords": [
    "agentdomain",
    "ai-agents",
    "elizaos",
    "identity",
    "x402",
    "base"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talvono/AgentDomain.git",
    "directory": "packages/eliza-plugin"
  },
  "homepage": "https://docs.agentdomain.app/frameworks/elizaos",
  "bugs": {
    "url": "https://github.com/Talvono/AgentDomain/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:ci": "tsc",
    "lint:ci": "echo \"no lint\"",
    "typecheck:ci": "tsc --noEmit",
    "test:ci": "node --test test/*.test.mjs",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm --filter @agentdomain/sdk build && pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint\""
  },
  "dependencies": {
    "@agentdomain/sdk": "workspace:^",
    "@agentdomain/shared": "workspace:^",
    "viem": "^2.56.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
